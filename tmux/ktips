#!/usr/bin/env bash
# ❓ ktips — shortcuts + tips for the Neon Night terminal (pure bash, no extra tools)
#
#   ktips          help screen: the top bar, keys, copy & paste, and a tip
#   ktips --one    one random tip, never the same twice in a row
#                  (the Kronikus greeting shows one each time a terminal opens)
#
# Help screen keys: n / p next / previous tip · t take the tour · a all tmux keys · q close
# Inside tmux: click ❓ in the top bar or press prefix + ?.

tips=(
    # 🖱️ top bar
    'Click ＋ in the top bar for a new terminal in this folder'
    'Click ◀ ▶ in the top bar to go to the previous / next terminal'
    'New here or rusty? ktour is a hands-on tour, chapter by chapter'
    'Click ▾ in the top bar to open bash, fish or a split'
    'Scroll the mouse wheel over the top bar to flip through windows'
    'Right-click a window in the top bar to rename, move or close it'
    'Click the 👻 session name in the top bar to switch sessions'
    'Click ✎ next to the session name to rename the session'
    'Click your avatar in the top bar (or Ctrl+b S) for ⚙ settings'
    'ksettings: avatar, name, greeting, tips, see-through and bar position'
    'Window too see-through? ⚙ settings → See-through → 100% makes it solid'
    'Cursor as a bar │, underline _, block █ or dot ●, thin or thick: ⚙ settings → Cursor'
    'In gterminal, r renames a session, saved ones too'
    'Click ❓ in the top bar (or Ctrl+b ?) for all shortcuts'
    'Click 🎨 in the top bar (or Ctrl+b T) to try other themes live'
    'Themes follow your desktop: light when it is light, dark when it is dark'
    'In the theme picker, d keeps the dark side only, l the light side only'
    'ktheme "Rose Pine" sets any Ghostty theme, ktheme --list shows all'
    # ⌨️ tmux
    'Ctrl+b z zooms the current split to full size, and back'
    'Ctrl+b d detaches: everything keeps running, gterminal brings it back'
    'Ctrl+b , renames the current window'
    'Ctrl+b w shows every window of every session as a tree'
    'Ctrl+b [ scrolls back with the keys, q leaves'
    'Ctrl+b Space cycles through split layouts'
    'Ctrl+b ! moves the current split into its own window'
    'Ctrl+b $ renames the current session (its saved folder + command come along)'
    'Ctrl+b x closes the current split (it asks first)'
    'Drag the line between two splits with the mouse to resize them'
    'Click a split to focus it, no keys needed'
    # 👻 gterminal
    'Type gterminal in any terminal to jump back into a session'
    '💤 saved sessions reopen in the same folder with your last command typed'
    'In gterminal, x kills a live session or forgets a saved one'
    'In gterminal, 1-9 opens that row right away'
    # 👻 Ghostty
    'Ghostty: Ctrl+Shift+T opens a tab, Alt+1..9 jumps between tabs'
    'Ghostty: Ctrl+Shift+O / Ctrl+Shift+E split the window side / down'
    'Ghostty: Ctrl+= and Ctrl+- zoom the font, Ctrl+0 resets it'
    'Ghostty: Ctrl+Shift+, reloads the config'
    'Ghostty: Ctrl+click a link to open it'
    'Selecting text with the mouse already copies it, just paste'
    # 🐚 shell
    'cd - jumps back to the folder you were in before'
    'Ctrl+R searches your command history, type a few letters'
    'sudo !! runs the last command again with sudo (bash)'
    'Alt+. pastes the last word of the previous command'
    'Ctrl+A / Ctrl+E jump to the start / end of the line'
    'Ctrl+W deletes the word before the cursor, Ctrl+U the whole line'
    'Ctrl+L clears the screen but keeps what you typed'
    'fish: press → to accept the grey suggestion, Alt+→ for one word'
    'Ctrl+Z pauses a program, fg brings it back'
    'End a command with & to run it in the background, jobs lists them'
    'mkdir -p a/b/c makes every missing folder at once'
    'Pipe long output into less to scroll it: cmd | less, q quits'
    'Ctrl+X Ctrl+E edits the current command in your editor (bash)'
    'Tab twice shows everything that can complete what you typed'
    # 🌿 git
    'git switch - goes back to the branch you were on before'
    'git add -p lets you pick which changes to stage, piece by piece'
    'git log --oneline --graph shows the history as a tree'
    'git stash puts unfinished work aside, git stash pop brings it back'
    'git commit --amend fixes the last commit (before you push)'
    'git diff --staged shows what the next commit will contain'
    # 🥽 Kronikus
    'The prompt arrow turns red when the last command failed'
    'The finish spinner can be turned off in ⚙ settings (ksettings)'
    'Tips like this one can be turned off in ⚙ settings (ksettings)'
)

state=${XDG_STATE_HOME:-$HOME/.local/state}/kronikus
b=$'\e[1m' d=$'\e[2m' r=$'\e[0m' m=$'\e[35m' c=$'\e[36m' y=$'\e[33m'

# The tips say Ctrl+b; show the real prefix if it was changed.
prefix=Ctrl+b
if [[ -n $TMUX ]]; then
    p=$(tmux show -gv prefix 2>/dev/null)
    [[ -n $p ]] && { p=${p/C-/Ctrl+}; prefix=${p/M-/Alt+}; }
fi

# Random tip index in REPLY, never the one shown last time.
pick() {
    local last=-1
    [[ -f $state/tip ]] && read -r last < "$state/tip"
    REPLY=$(( RANDOM % ${#tips[@]} ))
    (( REPLY == last )) && REPLY=$(( (REPLY + 1) % ${#tips[@]} ))
    mkdir -p "$state" && echo "$REPLY" > "$state/tip"
}

if [[ $1 == --one ]]; then
    pick
    printf '💡 %s%s%s\n' "$y" "${tips[REPLY]//Ctrl+b/$prefix}" "$r"
    exit
fi

# One row: key at column 5, what it does at 21. Optional second pair at 39 / 47.
row() {
    printf '    %s%s%s\e[21G%s' "$b$c" "$1" "$r" "$2"
    [[ -n $3 ]] && printf '\e[39G%s%s%s\e[47G%s' "$b$c" "$3" "$r" "$4"
    printf '\n'
}
title() { printf '\n  %s%s%s %s%s%s\n' "$b" "$1" "$r" "$d" "$2" "$r"; }

draw() {
    printf '\e[H\e[2J\n  %s❓ help & tips%s\n' "$b$m" "$r"

    title '🖱️  TOP BAR' '(tmux)'
    row '🥽 Kronikus' 'you: click for ⚙ settings (avatar, greeting, cursor…)'
    row '👻 session' 'switch, reopen or start sessions (gterminal)'
    row '✎'          'rename the session'
    row '1 🐚 bash'  'click to switch · scroll the wheel to flip through'
    row '◀ ▶'        'previous / next terminal'
    row 'right-click' 'a window: rename, move or close it'
    row '＋'         'new terminal in this folder'
    row '▾'          'bash, fish, split side / down, sessions, tour'
    row '🎨'         'theme: preview live, light / dark follow the desktop'
    row '❓'         'this screen'

    title '⌨️  KEYS' "press $prefix, let go, then:"
    row 'c'   'new window'         '1-9'    'go to window'
    row 'n p' 'next / previous'    'w'      'all windows'
    row '% "' 'split side / down'  '←↑↓→'   'move between splits'
    row 'z'   'zoom split'         'x'      'close split'
    row ','   'rename window'      'd'      'detach (keeps running)'
    row 's'   'sessions'           '['      'scroll, q leaves'
    row '$'   'rename session'     'T'      'theme'
    row 'S'   'settings'           '?'      'this screen'

    title '📋 COPY & PASTE'
    row 'drag'          'copied as soon as you let go'
    row 'double-click'  'copy a word · triple-click copies a line'
    row 'Shift + drag'  "Ghostty's own selection (outside tmux's)"
    row 'Ctrl+Shift+V'  'paste'

    title '💡 TIP' "$(( tip + 1 ))/${#tips[@]}"
    printf '    %s%s%s\n\n' "$y" "${tips[tip]//Ctrl+b/$prefix}" "$r"

    printf '  %sn%s %snext tip%s   %sp%s %sprevious%s   %st%s %stour%s' "$b" "$r" "$d" "$r" "$b" "$r" "$d" "$r" "$b" "$r" "$d" "$r"
    [[ -n $TMUX ]] && printf '   %sa%s %sall tmux keys%s' "$b" "$r" "$d" "$r"
    printf '   %sq%s %sclose%s' "$b" "$r" "$d" "$r"
}

pick
tip=$REPLY
printf '\e[?1049h\e[?25l'
trap "printf '\e[?25h\e[?1049l'" EXIT
trap : WINCH  # resize: interrupts read below, so the loop redraws
while :; do
    draw
    IFS= read -rsn1 key || continue
    [[ $key == $'\e' ]] && { IFS= read -rsn2 -t 0.05 rest; key+=$rest; }
    case $key in
        n|' '|$'\e[C'|$'\e[B') tip=$(( (tip + 1) % ${#tips[@]} )) ;;
        p|$'\e[D'|$'\e[A')     tip=$(( (tip - 1 + ${#tips[@]}) % ${#tips[@]} )) ;;
        t) if [[ -n $TMUX ]]; then tmux new-window -S -n tour "${BASH_SOURCE%/*}/ktour"; exit 0
           else printf '\e[?25h\e[?1049l'; trap - EXIT; exec "${BASH_SOURCE%/*}/ktour"
           fi ;;
        a) [[ -n $TMUX ]] && { printf '\e[?25h'; tmux list-keys -N | less; printf '\e[?25l'; } ;;
        q|$'\e'|'') exit 0 ;;
    esac
done
