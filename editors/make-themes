load = lambda name: importlib.machinery.SourceFileLoader(name, os.path.join(HERE, '..', 'ghostty', name)).load_module()
tune, mt = load('tune-themes'), load('monkeytype-themes')
lum, contrast, mix, distance, lch, from_lch, lift = tune.lum, tune.contrast, tune.mix, tune.distance, tune.lch, tune.from_lch, mt.lift

FAMILIES = {'Neon': 'Neon ', 'Solid': 'Solid ', 'Monkeytype': 'MT '}  # family → name prefix
AUTHORS = {'Neon': 'Kronikus', 'Solid': 'Kronikus, tuned from the original themes',
           'Monkeytype': 'Monkeytype (GPL-3.0), converted by Kronikus'}
CLEAR = '#00000000'

def tint(base, color, amount, *needs):
    """base moved towards color, as far as every (text, contrast) in needs stays readable on it."""
    steps = (mix(base, color, amount * (1 - i / 20)) for i in range(20))
    return next((c for c in steps if all(contrast(text, c) >= r for text, r in needs)), base)

def roles(path):
    """The Ghostty theme as named editor colors."""
    t = tune.read(path)
    bg, fg, p = t['background'], t['foreground'], t['palette']
    dark, quiet, accent = lum(fg) > lum(bg), p[8], p[5]
    # On a mid-tone background 4.5:1 can be out of reach or only near white: stay colored.
    target = min(4.5, .75 * contrast('#ffffff' if dark else '#000000', bg))
    code = lambda c: c if contrast(c, bg) >= target else lift(c, bg, target, dark)
    keep = {'keyword', 'red'}  # the theme's own colors: the others make way for them, and each other
    def made(i):  # a pure white accent leaves these grey in the palette: give them back their hue
        L, C, _ = lch(p[i])
        return p[i] if C >= .03 else from_lch(min(L, .8), .08, math.radians(mt.HUES[i]))
    syn = {'keyword': code(p[5]), 'red': code(p[1])} | {k: code(made(i)) for k, i in dict(green=2, yellow=3, blue=4, cyan=6).items()}
    for _ in range(60):
        d, a, b = min((distance(syn[a], syn[b]), a, b) for a in syn for b in syn if a < b and not {a, b} <= keep)
        if d >= mt.APART:
            break
        for k, other in ((a, b), (b, a)):
            if k not in keep:
                L, C, H = lch(syn[k])
                syn[k] = code(from_lch(L, C, H + math.copysign(math.radians(5), math.remainder(H - lch(syn[other])[2], math.tau))))
    # Surfaces for chips and picked rows, which text sits on.
    chip = tint(bg, p[0], 1, (fg, 4.5), (quiet, 3))
    pick = tint(chip, accent, .3, (fg, 4.2))
    if contrast(pick, chip) < 1.12:  # an accent as pale as the text can't mark a row: away from the text then
        pick = mix(chip, '#000000' if dark else '#ffffff', .25)
    return dict(
        dark=dark, bold=distance(accent, fg) < mt.APART, bg=bg, fg=fg, accent=accent, quiet=quiet, dim=p[7],
        chip=chip, pick=pick, line=mix(bg, quiet, .25), hover=fg + '14', sel=t['selection-background'],
        caret=t['cursor-color'], caret_text=t['cursor-text'], palette=p, pink=code(p[13]), special=code(p[14]),
        on_accent=max((bg, fg, '#000000', '#ffffff'), key=lambda c: contrast(c, accent)), **syn)

