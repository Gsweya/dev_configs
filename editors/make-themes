        'charts.blue': blue, 'charts.purple': key, 'charts.orange': cyan,
        'terminal.background': bg, 'terminal.foreground': fg, 'terminal.selectionBackground': r['sel'] + '99',
        'terminalCursor.foreground': r['caret'], 'terminalCursor.background': r['caret_text'],
        'terminal.border': line, 'terminal.tab.activeBorder': accent,
    }
    for i, color in enumerate((key, blue, cyan, green, yellow, r['pink'])):
        c[f'editorBracketHighlight.foreground{i + 1}'] = color
    for i, n in enumerate('Black Red Green Yellow Blue Magenta Cyan White'.split()):
        c[f'terminal.ansi{n}'] = p[i]
        c[f'terminal.ansiBright{n}'] = p[i + 8]
    colors = syntax(r)
    tokens = []
    for scope, role, font in VSCODE_SCOPES:
        settings = {'foreground': colors[role]}
        font = font or ('bold' if r['bold'] and role == 'keyword' else '')
        if font:
            settings['fontStyle'] = font
        tokens.append({'scope': [s.strip() for s in scope.split(',')], 'settings': settings})
    return {'$schema': 'vscode://schemas/color-theme', 'name': name, 'type': 'dark' if r['dark'] else 'light',
            'semanticHighlighting': True, 'colors': c, 'tokenColors': tokens}

def pack(files):
    """A .vsix is a zip with a manifest. The dates are fixed so the same themes give the same file."""
    package = json.loads(files['extension/package.json'])
    identity = f'Id="{package["name"]}" Version="{package["version"]}" Publisher="{package["publisher"]}"'
    files = {
        '[Content_Types].xml': '<?xml version="1.0" encoding="utf-8"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
            '<Default Extension=".json" ContentType="application/json"/><Default Extension=".vsixmanifest" ContentType="text/xml"/></Types>',
        'extension.vsixmanifest': '<?xml version="1.0" encoding="utf-8"?><PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011">'
            f'<Metadata><Identity Language="en-US" {identity}/><DisplayName>{package["displayName"]}</DisplayName>'
            f'<Description xml:space="preserve">{package["description"]}</Description><Categories>Themes</Categories>'
            f'<Properties><Property Id="Microsoft.VisualStudio.Code.Engine" Value="{package["engines"]["vscode"]}"/></Properties></Metadata>'
            '<Installation><InstallationTarget Id="Microsoft.VisualStudio.Code"/></Installation><Dependencies/>'
            '<Assets><Asset Type="Microsoft.VisualStudio.Code.Manifest" Path="extension/package.json" Addressable="true"/></Assets></PackageManifest>',
        **files,
    }
    out = io.BytesIO()
    with zipfile.ZipFile(out, 'w', zipfile.ZIP_DEFLATED) as z:
        for path, text in files.items():
            z.writestr(zipfile.ZipInfo(path, (1980, 1, 1, 0, 0, 0)), text, zipfile.ZIP_DEFLATED)
    return out.getvalue()

def main():
    names = sorted(os.listdir(THEMES))
    os.makedirs(ZED, exist_ok=True)
    contributes, files = [], {}
    for family, prefix in FAMILIES.items():
        themes = []
        for name in (n for n in names if n.startswith(prefix)):
            r = roles(os.path.join(THEMES, name))
            themes.append(zed_theme(name, r))
            path = 'themes/' + re.sub(r'[^a-z0-9]+', '-', name.lower()) + '.json'
            files['extension/' + path] = json.dumps(vscode_theme(name, r), indent=2, ensure_ascii=False)
            contributes.append({'label': name, 'uiTheme': 'vs-dark' if r['dark'] else 'vs', 'path': './' + path})
        with open(os.path.join(ZED, family + '.json'), 'w') as f:
            json.dump({'$schema': 'https://zed.dev/schema/themes/v0.2.0.json', 'name': family, 'author': AUTHORS[family],
                       'themes': themes}, f, indent=2, ensure_ascii=False)
            f.write('\n')
    files['extension/package.json'] = json.dumps({
        'name': 'kronikus-themes', 'displayName': 'Kronikus Themes', 'publisher': 'kronikus', 'version': VERSION,
        'description': 'Neon, Solid and Monkeytype themes, the same as in Ghostty. Monkeytype colors are GPL-3.0.',
        'engines': {'vscode': '^1.70.0'}, 'categories': ['Themes'], 'contributes': {'themes': contributes}}, indent=2, ensure_ascii=False)
    with open(VSIX, 'wb') as f:
        f.write(pack(files))
    print(len(contributes), 'themes')

if __name__ == '__main__':
    main()
