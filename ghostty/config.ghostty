# 👻 Neon — a rose + mint + violet Ghostty setup, light & dark (and fast)

# ── ✒️ Font ──────────────────────────────────────────
font-family = Lilex
font-size = 13
font-style = "Medium"
font-thicken = true
font-feature = +calt
font-feature = +liga

# ── 🎨 Theme ────────────────────────────────────────
# Follows the desktop: ☀️ Neon Day when it's light, 🌙 Neon Night when it's dark
# (both in themes/). Pick another one with 🎨 in the tmux bar or `ktheme`; that
# writes theme.ghostty next to this file, which overrides the line below.
theme = light:Neon Day,dark:Neon Night
config-file = ?theme.ghostty

# ── ✨ Cursor ────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true
adjust-cursor-thickness = 3

# ── 🪟 Window ────────────────────────────────────────
background-opacity = 0.93
background-blur = 12
window-decoration = auto
window-theme = auto
title = "👻 Ghostty"
window-padding-x = 16
window-padding-y = 12
window-padding-balance = true
window-padding-color = background

# ── 🐚 Shell ─────────────────────────────────────────
shell-integration = detect
shell-integration-features = title
scrollback-limit = 12000

# ── ⚡ Quality of life ───────────────────────────────
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false
resize-overlay = never
gtk-single-instance = true
link-url = true
link-previews = false
